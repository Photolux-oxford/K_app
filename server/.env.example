SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Postgres via Docker (recommended; avoids SQLite lock errors with WebSockets):
DATABASE_URL=postgresql://kayphoto:kayphoto@127.0.0.1:15432/kayphoto
# Omit DATABASE_URL to fall back to SQLite (not recommended for local dev with messaging)

# Optional. Leave unset for local single-process chat (in-memory).
# With docker compose redis: REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:5173
BOOKING_DEFAULT_PRICE=150.00

# CORS / CSRF (comma-separated in production)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Stripe (optional in dev — uses dev payment links when STRIPE_SECRET_KEY is unset)
# Test mode secret key: sk_test_... from Dashboard → Developers → API keys
# Webhook secret: whsec_... from `stripe listen --forward-to localhost:8000/api/payments/webhook/`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# getAddress.io — street-level UK address list (optional)
# Your private API key may authenticate Usage/Get but still return 401 for Autocomplete
# on some new accounts. If that happens:
#   1) In getAddress → Domain Tokens → Add host "localhost" (Limit e.g. 20)
#   2) Put the dtoken_… value here instead of the private API key
#   3) Restart Django
# Until then the form falls back to area suggestions from postcodes.io + manual address entry.
GETADDRESS_API_KEY=

# Email (defaults to console backend in dev — printed in runserver logs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@kaytubillla.com
EMAIL_TIMEOUT=20
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# On Railway, if Gmail SMTP hangs, use Resend instead (https://resend.com):
# RESEND_API_KEY=re_...
# DEFAULT_FROM_EMAIL must be a verified sender/domain in Resend


# Google Sign-In (GIS button → ID token). Client ID is required on API + Vite build.
# Client secret is optional for this flow (keep it private on Railway if you store it).
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Optional S3 media storage
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

